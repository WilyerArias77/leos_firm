# ═══════════════════════════════════════════════════════════════
# LEOS FIRM LLC — Variables de entorno
# ═══════════════════════════════════════════════════════════════
#
# Copiar a `.env.local` y rellenar con valores reales.
# `.env*` está en .gitignore — NUNCA commitear valores reales.
#
# Validación: src/lib/env.ts (la app no arranca si falta una requerida)
# Documentación: docs/02-architecture.md · Seguridad: docs/03-security.md
#
# ⚠️ REGLA: las variables con prefijo NEXT_PUBLIC_ se incrustan en el
# JavaScript del navegador y son PÚBLICAS. Nunca poner un secreto ahí.
# ═══════════════════════════════════════════════════════════════

# ─── Sitio ─────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── n8n (capa de integración — ADR-010) ───────────────────────
# n8n es lo ÚNICO que tiene credenciales de Google. Next.js le manda
# los datos por webhook y n8n escribe en Sheets / Calendar / Gmail.
#
# URL de producción del webhook del workflow "Leos Firm - CRM de leads".
# Se copia del nodo Webhook en n8n (Production URL, NO Test URL).
# El host real de la instancia no se commitea: se pone en .env.local y en Vercel.
N8N_CRM_WEBHOOK_URL=https://TU-INSTANCIA-N8N/webhook/leos-firm/crm
# ⚠️ SECRETA — mínimo 16 caracteres. Debe coincidir con la credencial
# "Header Auth" del nodo Webhook en n8n (nombre de header: x-leosfirm-token).
# La MISMA credencial sirve para los cuatro webhooks: no crear una por workflow.
# Generar con: openssl rand -base64 32
N8N_WEBHOOK_TOKEN=

# ─── n8n · Agendamiento (FASE 5) ───────────────────────────────
# Contrato campo por campo: docs/features/scheduling.md § Contrato exacto.
#
# OPCIONALES a propósito: sin ellas la app arranca igual y el CRM sigue
# funcionando. Fuera de producción, la disponibilidad cae a un mock local
# (src/lib/n8n/mock.ts). En producción sin estas URLs, /agendar responde 502
# con el teléfono de la firma — nunca horarios inventados.
#
# Copiar la Production URL del nodo Webhook, NO la Test URL.
N8N_AVAILABILITY_WEBHOOK_URL=https://TU-INSTANCIA-N8N/webhook/leos-firm/disponibilidad
N8N_BOOKING_WEBHOOK_URL=https://TU-INSTANCIA-N8N/webhook/leos-firm/reservar
# Libera el hueco en cuanto el visitante abandona la pantalla de pago, en vez de
# esperar los SLOT_HOLD_MINUTES del limpiador (2026-08-07).
# Sin esta variable NO se pierde nada: el hueco expira igual, solo que más tarde.
N8N_RELEASE_WEBHOOK_URL=https://TU-INSTANCIA-N8N/webhook/leos-firm/liberar
# Lo llama el webhook de Square, no el navegador (FASE 6)
N8N_CONFIRM_WEBHOOK_URL=https://TU-INSTANCIA-N8N/webhook/leos-firm/confirmar
# Registro de pagos: reclama el pago (anti-replay) y escribe la fila en la
# pestaña "Pagos" de la hoja del CRM. ADR-013 · docs/features/payments.md
N8N_PAYMENTS_WEBHOOK_URL=https://TU-INSTANCIA-N8N/webhook/leos-firm/pago

# ─── n8n · Gestión de la cita (FASE 9) ─────────────────────────
# Contrato campo por campo: docs/features/appointment-management.md
#
# OPCIONALES como las de agendamiento. Fuera de producción caen al mock local;
# en producción sin ellas la página de la cita responde 502 con el teléfono.
#
# Lee la cita del calendario para poder mostrarla (no hay base de datos)
N8N_APPOINTMENT_WEBHOOK_URL=https://TU-INSTANCIA-N8N/webhook/leos-firm/cita
# Libera el slot, pone el CRM en 'cancelado' y avisa por correo a Claudia y al cliente
N8N_CANCEL_WEBHOOK_URL=https://TU-INSTANCIA-N8N/webhook/leos-firm/cancelar
# Solo manda un correo a Claudia: NO reagenda nada. Es el camino de <24 h
N8N_RESCHEDULE_WEBHOOK_URL=https://TU-INSTANCIA-N8N/webhook/leos-firm/reprogramar
# ESTE SI mueve la cita (ADR-019). Conserva el Meet: no toca conferenceData
N8N_MOVE_WEBHOOK_URL=https://TU-INSTANCIA-N8N/webhook/leos-firm/mover

# ─── Supabase (CONGELADO — ADR-010) ────────────────────────────
# No se usa: el CRM vive en Google Sheets. Las tablas quedan diseñadas
# en docs/DB_SCHEMA.md pero no aplicadas. Dejar vacías.
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# ⚠️ SECRETA — bypassa RLS. Solo servidor. Nunca en el cliente.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Square ────────────────────────────────────────────────────
# developer.squareup.com → tu aplicación
NEXT_PUBLIC_SQUARE_APPLICATION_ID=
NEXT_PUBLIC_SQUARE_LOCATION_ID=
# ⚠️ SECRETA
SQUARE_ACCESS_TOKEN=
# sandbox | production
SQUARE_ENVIRONMENT=sandbox
# ⚠️ SECRETA — la muestra Square al registrar el webhook.
# Sandbox y producción tienen claves DISTINTAS.
SQUARE_WEBHOOK_SIGNATURE_KEY=

# ─── Google (Calendar + Gmail) ─────────────────────────────────
# Service account con delegación de dominio.
# Scopes mínimos: calendar.events, calendar.readonly, gmail.send
GOOGLE_CLIENT_EMAIL=nombre@proyecto.iam.gserviceaccount.com
# ⚠️ SECRETA — entre comillas y con los saltos de línea escapados como \n
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
# Calendario DEDICADO a las consultas, en el Google Console de marco@leosfirm.com (ADR-012).
# Sacarlo de Google Calendar → ⚙ Configuración → el calendario → «Integrar calendario».
# NO usar el calendario personal: el sitio lee su disponibilidad completa y crea/borra eventos.
GOOGLE_CALENDAR_ID=c_xxxxxxxxxxxx@group.calendar.google.com
# Usuario suplantado para enviar correo y crear enlaces de Meet
GOOGLE_IMPERSONATED_USER=claudia@leosfirm.com

# ─── Agente IA (Anthropic) ─────────────────────────────────────
# ⚠️ SECRETA — configurar un límite de gasto en la consola
ANTHROPIC_API_KEY=

# ─── Operación ─────────────────────────────────────────────────
# Recibe la copia de cada cita agendada
ADMIN_NOTIFICATION_EMAIL=claudia@leosfirm.com
# Zona horaria de la firma (San Antonio, TX)
BUSINESS_TIMEZONE=America/Chicago
# ⚠️ SECRETA — mínimo 16 caracteres aleatorios. Protege los endpoints /api/v1/cron/*
# Generar con: openssl rand -base64 32
CRON_SECRET=
# ⚠️ SECRETA — mínimo 32 caracteres. Firma el enlace que el cliente recibe por
# correo para ver, cancelar o pedir otro horario (ADR-016).
# Generar con: openssl rand -base64 32
#
# ⚠️ ROTARLA INVALIDA TODOS LOS ENLACES YA ENVIADOS, sin período de gracia:
# el token no se guarda en ningún lado, se verifica recalculando su firma.
# docs/features/appointment-management.md § ADR-016
APPOINTMENT_TOKEN_SECRET=

# ─── Zoom ──────────────────────────────────────────────────────
# RETIRADO el 2026-08-07: la sala virtual es SOLO Google Meet (ADR-004).
# Meet lo crea Google en la misma llamada que confirma la cita, con la
# credencial que ya está conectada. Zoom exigía OAuth server-to-server
# aparte y nunca llegó a implementarse.
