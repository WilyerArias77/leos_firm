# ═══════════════════════════════════════════════════════════════
# LEOS FIRM LLC — Variables de entorno
# ═══════════════════════════════════════════════════════════════
#
# Copiar a `.env.local` y rellenar con valores reales.
# `.env*` está en .gitignore — NUNCA commitear valores reales.
#
# Validación: src/lib/env.ts (la app no arranca si falta una requerida)
# Documentación: docs/02-architecture.md · Seguridad: docs/03-security.md
#
# ⚠️ REGLA: las variables con prefijo NEXT_PUBLIC_ se incrustan en el
# JavaScript del navegador y son PÚBLICAS. Nunca poner un secreto ahí.
# ═══════════════════════════════════════════════════════════════

# ─── Sitio ─────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── n8n (capa de integración — ADR-010) ───────────────────────
# n8n es lo ÚNICO que tiene credenciales de Google. Next.js le manda
# los datos por webhook y n8n escribe en Sheets / Calendar / Gmail.
#
# URL de producción del webhook del workflow "Leos Firm - CRM de leads".
# Se copia del nodo Webhook en n8n (Production URL, NO Test URL).
# El host real de la instancia no se commitea: se pone en .env.local y en Vercel.
N8N_CRM_WEBHOOK_URL=https://TU-INSTANCIA-N8N/webhook/leos-firm/crm
# ⚠️ SECRETA — mínimo 16 caracteres. Debe coincidir con la credencial
# "Header Auth" del nodo Webhook en n8n (nombre de header: x-leosfirm-token).
# Generar con: openssl rand -base64 32
N8N_WEBHOOK_TOKEN=

# ─── Supabase (CONGELADO — ADR-010) ────────────────────────────
# No se usa: el CRM vive en Google Sheets. Las tablas quedan diseñadas
# en docs/DB_SCHEMA.md pero no aplicadas. Dejar vacías.
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# ⚠️ SECRETA — bypassa RLS. Solo servidor. Nunca en el cliente.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Square ────────────────────────────────────────────────────
# developer.squareup.com → tu aplicación
NEXT_PUBLIC_SQUARE_APPLICATION_ID=
NEXT_PUBLIC_SQUARE_LOCATION_ID=
# ⚠️ SECRETA
SQUARE_ACCESS_TOKEN=
# sandbox | production
SQUARE_ENVIRONMENT=sandbox
# ⚠️ SECRETA — la muestra Square al registrar el webhook.
# Sandbox y producción tienen claves DISTINTAS.
SQUARE_WEBHOOK_SIGNATURE_KEY=

# ─── Google (Calendar + Gmail) ─────────────────────────────────
# Service account con delegación de dominio.
# Scopes mínimos: calendar.events, calendar.readonly, gmail.send
GOOGLE_CLIENT_EMAIL=nombre@proyecto.iam.gserviceaccount.com
# ⚠️ SECRETA — entre comillas y con los saltos de línea escapados como \n
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
# Calendario de Claudia (debe estar compartido con el service account)
GOOGLE_CALENDAR_ID=claudia@leosfirm.com
# Usuario suplantado para enviar correo y crear enlaces de Meet
GOOGLE_IMPERSONATED_USER=claudia@leosfirm.com

# ─── Agente IA (Anthropic) ─────────────────────────────────────
# ⚠️ SECRETA — configurar un límite de gasto en la consola
ANTHROPIC_API_KEY=

# ─── Operación ─────────────────────────────────────────────────
# Recibe la copia de cada cita agendada
ADMIN_NOTIFICATION_EMAIL=claudia@leosfirm.com
# Zona horaria de la firma (San Antonio, TX)
BUSINESS_TIMEZONE=America/Chicago
# ⚠️ SECRETA — mínimo 16 caracteres aleatorios. Protege los endpoints /api/v1/cron/*
# Generar con: openssl rand -base64 32
CRON_SECRET=

# ─── Zoom (OPCIONAL) ───────────────────────────────────────────
# Solo si se usa Zoom en lugar de Google Meet (ADR-004).
# Dejar vacías para usar Google Meet (default).
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
